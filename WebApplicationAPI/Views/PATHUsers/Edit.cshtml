@model PATHServer.BDD.Models.PATHUser

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>PATHUser</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="pu_id" />
            <div class="form-group">
                <label asp-for="pu_email" class="control-label"></label>
                <input asp-for="pu_email" class="form-control" />
                <span asp-validation-for="pu_email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="pu_name" class="control-label"></label>
                <input asp-for="pu_name" class="form-control" />
                <span asp-validation-for="pu_name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="pu_surname" class="control-label"></label>
                <input asp-for="pu_surname" class="form-control" />
                <span asp-validation-for="pu_surname" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="pu_admin" /> @Html.DisplayNameFor(model => model.pu_admin)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
